{
  "name": "car-rental",
  "version": "1.0.0",
  "private": true,
  "description": "Ιστοσελίδα ενοικίασης αυτοκινήτων: αναζήτηση διαθεσιμότητας, κρατήσεις, πληρωμές, λογαριασμοί πελατών και πίνακας διαχείρισης.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/db/seed.js",
    "create-admin": "node --disable-warning=ExperimentalWarning src/db/create-admin.js",
    "revolut:webhook": "node --disable-warning=ExperimentalWarning src/db/revolut-webhook.js",
    "clear-test-data": "node --disable-warning=ExperimentalWarning src/db/clear-test-data.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
