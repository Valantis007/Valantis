# ---------- Βασικά ----------
NODE_ENV=production
PORT=3000
# Η δημόσια διεύθυνση της ιστοσελίδας (χρησιμοποιείται σε emails και στο Stripe)
BASE_URL=https://www.example.gr
# Τυχαίο μακρύ κείμενο (π.χ. αποτέλεσμα: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=change-me
# Αρχείο βάσης δεδομένων SQLite
DB_PATH=./data/app.db
# Φάκελος για τις φωτογραφίες αυτοκινήτων που ανεβάζει ο διαχειριστής
UPLOAD_DIR=./data/uploads
# Αν η εφαρμογή τρέχει πίσω από reverse proxy (nginx, Render, Railway κ.λπ.)
TRUST_PROXY=1

# ---------- Στοιχεία επιχείρησης ----------
COMPANY_NAME=Rent a Car
COMPANY_LEGAL_NAME=Επωνυμία Επιχείρησης Ι.Κ.Ε.
COMPANY_VAT=000000000
COMPANY_TAX_OFFICE=ΔΟΥ
COMPANY_GEMI=000000000000
COMPANY_ADDRESS=Οδός 1, 54600 Θεσσαλονίκη
COMPANY_PHONE=+30 2310 000000
COMPANY_EMAIL=info@example.gr

# ---------- Κανόνες ενοικίασης ----------
TIMEZONE=Europe/Athens
OPENING_HOUR=8
CLOSING_HOUR=22
MIN_LEAD_MINUTES=120
MAX_RENTAL_DAYS=90
MAX_ADVANCE_DAYS=365
TURNAROUND_MINUTES=60
FREE_CANCELLATION_HOURS=48
ONE_WAY_FEE=30
MIN_LICENSE_YEARS=1
VAT_PERCENT=24
# Έκπτωση διάρκειας: "ημέρες:ποσοστό" χωρισμένα με κόμμα
DURATION_DISCOUNTS=7:5,14:10,28:15
# Λεπτά που «κρατιέται» το αυτοκίνητο μέχρι να ολοκληρωθεί η πληρωμή με κάρτα
PAYMENT_HOLD_MINUTES=35

# ---------- Πληρωμές (Stripe) ----------
# Αν μείνουν κενά, η ιστοσελίδα δέχεται μόνο «Πληρωμή κατά την παραλαβή».
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Email (SMTP) ----------
# Αν μείνουν κενά, τα emails καταγράφονται στο log αντί να αποστέλλονται.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rent a Car <no-reply@example.gr>"
# Πού στέλνονται οι ειδοποιήσεις για νέες κρατήσεις / μηνύματα
ADMIN_NOTIFY_EMAIL=info@example.gr

# ---------- Αρχικός διαχειριστής (χρησιμοποιείται από το npm run seed) ----------
ADMIN_EMAIL=admin@example.gr
ADMIN_PASSWORD=
