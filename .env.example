# ---------- Βασικά ----------
NODE_ENV=production
PORT=3000
# Η δημόσια διεύθυνση της ιστοσελίδας (χρησιμοποιείται σε emails και στο Stripe)
BASE_URL=https://www.example.gr
# Τυχαίο μακρύ κείμενο (π.χ. αποτέλεσμα: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=change-me
# Αρχείο βάσης δεδομένων SQLite
DB_PATH=./data/app.db
# Φάκελος για τις φωτογραφίες αυτοκινήτων που ανεβάζει ο διαχειριστής
UPLOAD_DIR=./data/uploads
# Αν η εφαρμογή τρέχει πίσω από reverse proxy (Caddy, nginx, Render, Railway κ.λπ.).
# ΠΡΟΣΟΧΗ: ορίστε το ΜΟΝΟ αν η θύρα της εφαρμογής ΔΕΝ είναι προσβάσιμη απευθείας από το internet.
TRUST_PROXY=1

# ---------- Στοιχεία επιχείρησης ----------
COMPANY_NAME=Rent a Car
COMPANY_LEGAL_NAME=Επωνυμία Επιχείρησης Ι.Κ.Ε.
COMPANY_VAT=000000000
COMPANY_TAX_OFFICE=ΔΟΥ
COMPANY_GEMI=000000000000
COMPANY_ADDRESS=Οδός 1, 54600 Θεσσαλονίκη
COMPANY_PHONE=+30 2310 000000
COMPANY_EMAIL=info@example.gr

# ---------- Κανόνες ενοικίασης ----------
TIMEZONE=Europe/Athens
OPENING_HOUR=8
CLOSING_HOUR=22
MIN_LEAD_MINUTES=120
MAX_RENTAL_DAYS=90
MAX_ADVANCE_DAYS=365
TURNAROUND_MINUTES=60
FREE_CANCELLATION_HOURS=48
ONE_WAY_FEE=30
MIN_LICENSE_YEARS=1
VAT_PERCENT=24
# Έκπτωση διάρκειας: "ημέρες:ποσοστό" χωρισμένα με κόμμα
DURATION_DISCOUNTS=7:5,14:10,28:15
# Λεπτά που «κρατιέται» το αυτοκίνητο μέχρι να ολοκληρωθεί η πληρωμή με κάρτα (ελάχιστο 35)
PAYMENT_HOLD_MINUTES=35

# ---------- Online πληρωμές ----------
# Αν δεν ρυθμιστεί κανένας πάροχος, η ιστοσελίδα δέχεται μόνο «Πληρωμή κατά την παραλαβή»
# και η εγγύηση δεσμεύεται μόνο με το POS του γραφείου.
# Ποιος πάροχος χρησιμοποιείται για νέες πληρωμές: stripe ή revolut (κενό = όποιος έχει ρυθμιστεί).
PAYMENT_PROVIDER=

# Stripe (https://dashboard.stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Δέσμευση εγγύησης έως 30 ημέρες αντί για 7 (απαιτεί έγκριση από το Stripe — τιμολόγηση IC+)
STRIPE_EXTENDED_AUTHORIZATION=false

# Revolut Business (Merchant → API: Secret key). Το webhook εγγράφεται με: npm run revolut:webhook
REVOLUT_SECRET_KEY=
REVOLUT_WEBHOOK_SECRET=
# true για δοκιμές με λογαριασμό Revolut Business Sandbox
REVOLUT_SANDBOX=false

# ---------- Εγγύηση ----------
# Από πόσες ώρες πριν την παραλαβή μπορεί ο πελάτης να εγκρίνει online τη δέσμευση
DEPOSIT_LINK_OPENS_HOURS=48
# Ημέρες που έχει ο πελάτης για να αποδεχθεί ή να αμφισβητήσει χρέωση ζημιάς
DAMAGE_RESPONSE_DAYS=7
# Αυτόματη αποδέσμευση online εγγύησης Χ ώρες μετά την επιστροφή, αν δεν υπάρχουν χρεώσεις (0 = ποτέ)
DEPOSIT_AUTO_RELEASE_HOURS=48

# ---------- Email (SMTP) ----------
# Αν μείνουν κενά, τα emails καταγράφονται στο log αντί να αποστέλλονται.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rent a Car <no-reply@example.gr>"
# Πού στέλνονται οι ειδοποιήσεις για νέες κρατήσεις / μηνύματα
ADMIN_NOTIFY_EMAIL=info@example.gr

# ---------- Αρχικός διαχειριστής (χρησιμοποιείται από το npm run seed) ----------
ADMIN_EMAIL=admin@example.gr
ADMIN_PASSWORD=
