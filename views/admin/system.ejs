<%- include('../partials/header') %>
<div class="container section">
  <%- include('_nav') %>
  <h1>Έλεγχος συστήματος</h1>
  <p class="muted">Ελέγξτε εδώ, πριν το άνοιγμα και μετά από κάθε αλλαγή ρυθμίσεων, ότι όλα λειτουργούν. Ο πλήρης οδηγός δοκιμών είναι στο αρχείο <code>docs/anoigma-kai-dokimes.md</code>.</p>

  <% if (results) { %>
    <div class="alert <%= results.ok ? 'alert-success' : 'alert-error' %>" role="status">
      <strong><%= results.title %>: <%= results.ok ? 'όλα εντάξει' : 'χρειάζεται προσοχή' %></strong>
      <ul class="plain small"><% results.lines.forEach(function (l) { %><li><%= l %></li><% }) %></ul>
    </div>
  <% } %>

  <div class="grid-2 stack-gap">
    <div class="card pad">
      <h2 class="h4">Ρυθμίσεις</h2>
      <ul class="check-list">
        <% checks.forEach(function (c) { %>
          <li>
            <span class="check-icon check-<%= c.state %>" aria-label="<%= { ok: 'εντάξει', warn: 'προσοχή', bad: 'πρόβλημα' }[c.state] %>"><%= { ok: '✓', warn: '!', bad: '✕' }[c.state] %></span>
            <span><%= c.text %><% if (c.hint) { %><br><span class="small muted"><%= c.hint %></span><% } %><% if (c.link) { %><br><a class="small" href="<%= c.link.href %>"><%= c.link.text %> →</a><% } %></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="stack">
      <div class="card pad stack">
        <h2 class="h4">Δοκιμαστικό email</h2>
        <form method="post" action="/admin/system/test-email" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="field"><label for="test_to">Αποστολή σε</label><input id="test_to" name="to" type="email" value="<%= testEmailTo %>" required></div>
          <button class="btn" type="submit">Αποστολή δοκιμαστικού email</button>
        </form>
        <p class="small muted">Στείλτε σε Gmail και σε Outlook/Hotmail και ελέγξτε ότι δεν πάει στα ανεπιθύμητα.</p>
        <% if (!smtpConfigured && !config.isProduction) { %><p class="small">Δεν έχει ρυθμιστεί αποστολή email: <a href="/admin/settings#mail">ρυθμίστε τη στις Ρυθμίσεις δοκιμών →</a></p><% } %>
      </div>

      <div class="card pad stack">
        <h2 class="h4">Πληρωμές</h2>
        <p class="small"><%= provider ? `Πάροχος: ${provider.label}` : 'Δεν έχει ρυθμιστεί πάροχος online πληρωμών.' %><% if (!provider && !config.isProduction) { %> <a href="/admin/settings#stripe">Ρύθμιση δοκιμαστικών πληρωμών με κάρτα →</a><% } %></p>
        <form method="post" action="/admin/system/check-payments">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <button class="btn" type="submit" <%= provider ? '' : 'disabled' %>>Έλεγχος σύνδεσης &amp; webhook</button>
        </form>
      </div>

      <div class="card pad">
        <h2 class="h4">Δεδομένα</h2>
        <p class="small">Βάση: <code><%= dbPath %></code><% if (dbSize !== null) { %> (<%= (dbSize / 1024 / 1024).toFixed(1) %> MB)<% } %><br>
          Κρατήσεις: <%= counts.bookings %> · Ενεργά αυτοκίνητα: <%= counts.cars %> · Χρήστες: <%= counts.users %></p>
        <p class="small muted">Βεβαιωθείτε ότι γίνεται καθημερινό αντίγραφο ασφαλείας του φακέλου <code>data/</code>.</p>
      </div>
    </div>
  </div>

  <div class="card pad">
    <h2 class="h4">Τελευταία emails</h2>
    <p class="small muted">Κάντε μια δοκιμαστική κράτηση από την ιστοσελίδα και πατήστε «Προβολή» για να δείτε το email επιβεβαίωσης όπως θα το λάβει ο πελάτης (στη γλώσσα του), ακόμα κι αν δεν έχει ρυθμιστεί αποστολή email.</p>
    <% if (recentEmails.some(function (m) { return m.status === 'not_configured'; }) && !config.isProduction) { %>
      <p class="alert alert-warning small">Τα emails με «Δεν στάλθηκε (χωρίς SMTP)» δεν έφτασαν στους παραλήπτες, γιατί δεν έχει ρυθμιστεί αποστολή email. <a href="/admin/settings#mail">Ρύθμιση στις Ρυθμίσεις δοκιμών →</a></p>
    <% } %>
    <% if (!recentEmails.length) { %><p class="small muted">Δεν έχουν σταλεί emails από την τελευταία επανεκκίνηση.</p><% } else { %>
      <div class="table-wrap">
        <table class="table small">
          <thead><tr><th>Ώρα</th><th>Προς</th><th>Θέμα</th><th>Αποτέλεσμα</th><th></th></tr></thead>
          <tbody>
            <% recentEmails.forEach(function (m) { %>
              <tr>
                <td><%= format.utcTimestamp(m.at.replace('T', ' ').slice(0, 19), config.rules.timezone) %></td>
                <td><%= m.to %></td>
                <td><%= m.subject %></td>
                <td class="<%= m.status === 'sent' ? 'success' : 'error' %>"><%= { sent: 'Στάλθηκε', failed: 'Απέτυχε', not_configured: 'Δεν στάλθηκε (χωρίς SMTP)' }[m.status] %><% if (m.error) { %><br><span class="muted"><%= m.error %></span><% } %></td>
                <td><% if (m.html) { %><a href="/admin/system/emails/<%= m.id %>" target="_blank" rel="noopener">Προβολή</a><% if (m.attachments && m.attachments.length) { %><br><span class="muted">+ <%= m.attachments.join(', ') %></span><% } %><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
