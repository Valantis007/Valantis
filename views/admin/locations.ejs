<%- include('../partials/header') %>
<div class="container section">
  <%- include('_nav') %>
  <h1>Σημεία παραλαβής / επιστροφής</h1>
  <p class="muted small">Η χρέωση σημείου προστίθεται μία φορά ανά κράτηση (η μεγαλύτερη από παραλαβή/επιστροφή).</p>
  <div class="stack">
    <% rows.concat([null]).forEach(function (r) { %>
      <form method="post" action="/admin/locations<%= r ? `/${r.id}` : '' %>" class="card pad inline-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <div class="field"><label>Όνομα</label><input name="name" value="<%= r ? r.name : '' %>" required></div>
        <div class="field grow"><label>Διεύθυνση / οδηγίες</label><input name="address" value="<%= r ? r.address : '' %>"></div>
        <details class="translations"><summary>Μεταφράσεις (English / Español)</summary>
          <div class="grid-2">
            <div class="field"><label>Όνομα (English)</label><input name="name_en" value="<%= r ? r.name_en || '' : '' %>"></div>
            <div class="field"><label>Όνομα (Español)</label><input name="name_es" value="<%= r ? r.name_es || '' : '' %>"></div>
            <div class="field"><label>Διεύθυνση (English)</label><input name="address_en" value="<%= r ? r.address_en || '' : '' %>"></div>
            <div class="field"><label>Διεύθυνση (Español)</label><input name="address_es" value="<%= r ? r.address_es || '' : '' %>"></div>
          </div>
          <p class="small muted">Κενό = εμφανίζεται το ελληνικό κείμενο.</p>
        </details>
        <div class="field"><label>Χρέωση (€)</label><input name="fee" inputmode="decimal" value="<%= r ? format.centsToInput(r.fee_cents) : '0.00' %>" size="6"></div>
        <div class="field"><label>Σειρά</label><input name="sort_order" type="number" value="<%= r ? r.sort_order : rows.length + 1 %>" style="width:5em"></div>
        <label class="check"><input type="checkbox" name="active" value="1" <%= !r || r.active ? 'checked' : '' %>><span>Ενεργό</span></label>
        <button class="btn <%= r ? '' : 'btn-primary' %>" type="submit"><%= r ? 'Αποθήκευση' : '+ Προσθήκη' %></button>
      </form>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
