<%- include('../partials/header') %>
<% function err(fe, key) { return fe[key] ? `<span class="error">${fe[key].replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; })}</span>` : ''; } %>
<div class="container section">
  <%- include('_nav') %>
  <h1>Σημεία παραλαβής / επιστροφής</h1>
  <p class="muted small">Η χρέωση σημείου προστίθεται μία φορά ανά κράτηση (η μεγαλύτερη από παραλαβή/επιστροφή).</p>
  <p class="muted small">Ό,τι γράφετε στα ελληνικά το βλέπουν και οι ξένοι πελάτες: συμπληρώστε υποχρεωτικά και τη μετάφραση στα αγγλικά και στα ισπανικά (π.χ. με DeepL ή Google Translate).</p>
  <div class="stack">
    <% rows.concat([null]).forEach(function (r) {
      const key = r ? r.id : 'new';
      const editingThis = locals.editing !== null && locals.editing !== undefined && String(locals.editing) === String(key);
      const f = editingThis ? values : (r || {});
      const fe = editingThis ? errors : {};
      const val = function (name) { const x = f[name]; return x === null || x === undefined ? '' : x; };
      const fee = editingThis ? val('fee') : (r ? format.centsToInput(r.fee_cents) : '0.00');
      const active = editingThis ? f.active === '1' : (!r || r.active);
      const missingFields = r && missing && missing[r.id]; %>
      <form method="post" action="/admin/locations<%= r ? `/${r.id}` : '' %>" class="card pad inline-grid" <% if (r) { %>id="location-<%= r.id %>"<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <% if (missingFields) { %><p class="small translations-grid"><span class="badge-warn">⚠ Λείπει μετάφραση: <%= missingFields.join(', ') %></span></p><% } %>
        <div class="field"><label>Όνομα</label><input name="name" value="<%= val('name') %>" required><%- err(fe, 'name') %></div>
        <div class="field grow"><label>Διεύθυνση / οδηγίες</label><input name="address" value="<%= val('address') %>"></div>
        <div class="translations-grid">
          <div class="grid-2">
            <div class="field"><label>Όνομα (English)</label><input name="name_en" value="<%= val('name_en') %>" required <%= fe.name_en ? 'autofocus' : '' %>><%- err(fe, 'name_en') %></div>
            <div class="field"><label>Όνομα (Español)</label><input name="name_es" value="<%= val('name_es') %>" required><%- err(fe, 'name_es') %></div>
            <div class="field"><label>Διεύθυνση (English)</label><input name="address_en" value="<%= val('address_en') %>" <%= !fe.name_en && fe.address_en ? 'autofocus' : '' %>><%- err(fe, 'address_en') %></div>
            <div class="field"><label>Διεύθυνση (Español)</label><input name="address_es" value="<%= val('address_es') %>"><%- err(fe, 'address_es') %></div>
          </div>
          <p class="small muted">Η διεύθυνση είναι προαιρετική· αν τη γράψετε στα ελληνικά, χρειάζεται και στα αγγλικά και στα ισπανικά (οδοί και πόλεις με λατινικούς χαρακτήρες, π.χ. «Tsimiski 12, Thessaloniki»).</p>
        </div>
        <div class="field"><label>Χρέωση (€)</label><input name="fee" inputmode="decimal" value="<%= fee %>" size="6"><%- err(fe, 'fee') %></div>
        <div class="field"><label>Σειρά</label><input name="sort_order" type="number" value="<%= editingThis ? val('sort_order') : (r ? r.sort_order : rows.length + 1) %>" style="width:5em"></div>
        <label class="check"><input type="checkbox" name="active" value="1" <%= active ? 'checked' : '' %>><span>Ενεργό</span></label>
        <button class="btn <%= r ? '' : 'btn-primary' %>" type="submit"><%= r ? 'Αποθήκευση' : '+ Προσθήκη' %></button>
      </form>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
