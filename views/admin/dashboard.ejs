<%- include('../partials/header') %>
<div class="container section">
  <%- include('_nav') %>
  <h1>Πίνακας ελέγχου</h1>
  <div class="stats">
    <div class="stat card"><span class="stat-value"><%= stats.active %></span><span class="stat-label">Αυτοκίνητα σε ενοικίαση</span></div>
    <div class="stat card"><span class="stat-value"><%= stats.confirmed %></span><span class="stat-label">Επιβεβαιωμένες κρατήσεις</span></div>
    <div class="stat card"><span class="stat-value"><%= format.money(stats.monthRevenue) %></span><span class="stat-label">Τζίρος μήνα (με ΦΠΑ)</span></div>
    <div class="stat card"><span class="stat-value"><%= stats.fleet %></span><span class="stat-label">Ενεργά αυτοκίνητα</span></div>
    <a class="stat card" href="/admin/messages"><span class="stat-value"><%= stats.unreadMessages %></span><span class="stat-label">Μηνύματα σε εκκρεμότητα</span></a>
  </div>

  <% if (attention.deposits.length || attention.charges.length || refundProblems.length || refundsDue.length) { %>
    <div class="card pad attention">
      <h2 class="h3">Χρειάζονται ενέργεια</h2>
      <ul class="plain">
        <% attention.deposits.forEach(function (d) { %>
          <li><a class="ref" href="/admin/bookings/<%= d.booking_id %>"><%= d.reference %></a> · Εγγύηση <%= format.money(d.amount_cents) %> (<%= format.label('depositMethod', d.method) %>) — <%= d.notes.join(' · ') %></li>
        <% }) %>
        <% attention.charges.forEach(function (c) { %>
          <li><a class="ref" href="/admin/bookings/<%= c.booking_id %>"><%= c.reference %></a> · Χρέωση «<%= c.description %>» <%= format.money(c.amount_cents) %> — <%= format.label('chargeStatus', c.status) %><% if (c.status === 'proposed' && c.respond_by) { %> (προθεσμία <%= format.date(c.respond_by) %>)<% } %></li>
        <% }) %>
        <% refundProblems.forEach(function (r) { %>
          <li><a class="ref" href="/admin/bookings/<%= r.booking_id %>"><%= r.reference %></a> · <span class="error">Επιστροφή <%= format.money(r.amount_cents) %> <%= r.status === 'failed' ? 'απέτυχε' : 'καθυστερεί' %></span> — <%= r.last_error %></li>
        <% }) %>
        <% refundsDue.forEach(function (r) { %>
          <li><a class="ref" href="/admin/bookings/<%= r.id %>"><%= r.reference %></a> · Οφείλεται επιστροφή <%= format.money(r.due_cents) %> σε <%= r.first_name %> <%= r.last_name %> (εκτός συστήματος)</li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (fiscalPending.length) { %>
    <div class="card pad">
      <h2 class="h3">Παραστατικά προς έκδοση (myDATA)</h2>
      <p class="small muted">Εκδώστε το παραστατικό από το πρόγραμμα τιμολόγησης / ΦΗΜ και καταχωρήστε εδώ τον ΜΑΡΚ.</p>
      <div class="table-wrap">
        <table class="table small">
          <thead><tr><th>Κράτηση</th><th>Είδος</th><th>Ποσό</th><th>Περιγραφή</th><th>Τρόπος</th><th>ΜΑΡΚ</th></tr></thead>
          <tbody>
            <% fiscalPending.forEach(function (f) { %>
              <tr>
                <td><a class="ref" href="/admin/bookings/<%= f.booking_id %>"><%= f.reference %></a><br><%= f.invoice_name || (f.first_name + ' ' + f.last_name) %><% if (f.invoice_vat) { %><br>ΑΦΜ <%= f.invoice_vat %><% } %></td>
                <td><%= format.label('fiscalKind', f.kind) %></td>
                <td><%= format.money(f.amount_cents) %></td>
                <td><%= f.description %></td>
                <td><%= f.source %></td>
                <td>
                  <form method="post" action="/admin/fiscal/<%= f.id %>" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                    <input name="mark" maxlength="40" aria-label="ΜΑΡΚ" required>
                    <button class="btn btn-small" type="submit">OK</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <h2 class="h3">Παραδόσεις σήμερα (και εκπρόθεσμες)</h2>
  <%- include('_booking-table', { rows: pickups }) %>
  <h2 class="h3">Επιστροφές σήμερα (και εκπρόθεσμες)</h2>
  <%- include('_booking-table', { rows: returns }) %>
  <h2 class="h3">Επόμενες κρατήσεις</h2>
  <%- include('_booking-table', { rows: upcoming }) %>
</div>
<%- include('../partials/footer') %>
