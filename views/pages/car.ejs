<%- include('../partials/header') %>
<div class="container section">
  <p><a href="<%= u('/cars') %><%= search.ok ? `?${query}` : '' %>"><%= t('← Πίσω στα αποτελέσματα') %></a></p>
  <div class="car-detail">
    <div>
      <figure class="card car-hero"><img src="<%= car.image || `/img/cars/${car.category}.svg` %>" alt="<%= car.make %> <%= car.model %>">
        <% if (car.image_credit) { %><figcaption class="photo-credit"><%= t('Φωτογραφία') %>: <% if (car.image_source) { %><a href="<%= car.image_source %>" target="_blank" rel="noopener nofollow"><%= car.image_credit %></a><% } else { %><%= car.image_credit %><% } %></figcaption><% } %>
      </figure>
      <div class="card pad">
        <span class="badge"><%= format.label('category', car.category) %></span>
        <h1><%= car.make %> <%= car.model %> <span class="muted small">(<%= car.year %>) <%= t('ή παρόμοιο') %></span></h1>
        <%- include('../partials/car-specs', { car, full: true }) %>
        <% if (car.description) { %><p><%= tf(car, 'description') %></p><% } %>
        <h2 class="h4"><%= t('Περιλαμβάνονται στην τιμή') %></h2>
        <ul class="checklist">
          <li><%= format.mileage(car) %></li>
          <li><%= t('Υποχρεωτική ασφάλιση αστικής ευθύνης (έναντι τρίτων)') %></li>
          <li><%= t('Βασική κάλυψη ζημιών (CDW) — απαλλαγή {amount}', { amount: format.money(car.excess_cents ?? car.deposit_cents) }) %>
            <%# Η FDW είναι προαιρετική (με χρέωση): γραμμή κάτω από τη βασική κάλυψη, όχι στα «Περιλαμβάνονται». %>
            <% if (waiver) { %><span class="checklist-sub"><%= waiver.pricing === 'per_day'
              ? t('Μηδενική συμμετοχή με την Πλήρη Απαλλαγή (FDW): +{price}/ημέρα', { price: format.money(waiver.price_cents) })
              : t('Μηδενική συμμετοχή με την Πλήρη Απαλλαγή (FDW): +{price} ανά ενοικίαση', { price: format.money(waiver.price_cents) }) %></span><% } %></li>
          <% if (company.roadsideAssistance) { %><li><%= t('Οδική βοήθεια 24/7') %></li><% } %>
          <li><%= t('ΦΠΑ {vat}%', { vat: config.rules.vatPercent }) %></li>
        </ul>
        <h2 class="h4"><%= t('Απαιτήσεις') %></h2>
        <ul class="checklist muted">
          <li><%= t('Ελάχιστη ηλικία οδηγού: {age} ετών', { age: car.min_driver_age }) %></li>
          <li><%= t('Δίπλωμα οδήγησης τουλάχιστον {years} έτους', { years: config.rules.minLicenseYears }) %></li>
          <li><%- th('Εγγύηση {amount}: δέσμευση (όχι χρέωση) σε <strong>πιστωτική</strong> κάρτα στο όνομα του κύριου οδηγού — όχι χρεωστική ή προπληρωμένη', { amount: format.money(car.deposit_cents) }) %></li>
        </ul>
      </div>
    </div>
    <aside class="card pad sticky" id="availability" tabindex="-1">
      <h2 class="h3"><%= t('Τιμή & διαθεσιμότητα') %></h2>
      <div<%= quote ? '' : ' data-bottom-bar-target' %>><%- include('../partials/search-form', { locations, values: searchValues, errors, stacked: true, action: `/cars/${car.id}`, buttonLabel: 'Έλεγχος διαθεσιμότητας' }) %></div>
      <% if (search.ok && available === false) { %>
        <div class="alert alert-error"><%- th('Το αυτοκίνητο δεν είναι διαθέσιμο για αυτές τις ημερομηνίες. <a href="{url}">Δείτε διαθέσιμα αυτοκίνητα</a>.', { url: u(`/cars?${query}`) }) %></div>
      <% } else if (quote) { %>
        <div data-bottom-bar-target><%- include('../booking/_quote', { quote }) %></div>
        <%- include('../partials/payment-means') %>
        <a class="btn btn-primary btn-block" href="<%= u(`/booking/new?car_id=${car.id}`) %>&<%= query %>" data-bottom-bar-target><%= t('Συνέχεια στην κράτηση') %></a>
      <% } else { %>
        <p class="price"><%- th('από <strong>{price}</strong> / ημέρα', { price: format.money(car.daily_rate_cents) }) %></p>
      <% } %>
    </aside>
  </div>
</div>
<%# Κάτω μπάρα στο κινητό (≤900px): με τιμή, το σύνολο και «Συνέχεια στην κράτηση»· αλλιώς «Έλεγχος διαθεσιμότητας»,
    που πηγαίνει στη φόρμα ημερομηνιών (σύνδεσμος #, λειτουργεί και χωρίς JavaScript). %>
<div class="bottom-bar" data-bottom-bar>
  <% if (quote) { %>
    <p class="bottom-bar-price bottom-bar-stack"><%- quote.days === 1 ? th('<strong>{total}</strong> για 1 ημέρα', { total: format.money(quote.totalCents) }) : th('<strong>{total}</strong> για {n} ημέρες', { total: format.money(quote.totalCents), n: quote.days }) %></p>
    <a class="btn btn-primary" href="<%= u(`/booking/new?car_id=${car.id}`) %>&<%= query %>"><%= t('Συνέχεια στην κράτηση') %></a>
  <% } else { %>
    <p class="bottom-bar-price"><%- th('από<br><strong>{price}</strong> / ημέρα', { price: format.money(car.daily_rate_cents) }) %></p>
    <a class="btn btn-primary" href="#availability" data-bar-scroll><%= t('Έλεγχος διαθεσιμότητας') %></a>
  <% } %>
</div>
<%- include('../partials/footer') %>
