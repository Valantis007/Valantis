<%- include('../partials/header') %>
<div class="container section prose">
  <h1>Στοιχεία εταιρείας</h1>
  <dl class="kv">
    <dt>Επωνυμία</dt><dd><%= company.legalName %></dd>
    <dt>Διακριτικός τίτλος</dt><dd><%= company.name %></dd>
    <% if (company.seat) { %><dt>Έδρα</dt><dd><%= company.seat %></dd><% } %>
    <% if (company.address) { %><dt>Γραφείο</dt><dd><%= company.address %></dd><% } %>
    <% if (company.gemi) { %><dt>ΓΕΜΗ</dt><dd><%= company.gemi %></dd><% } %>
    <% if (company.vat) { %><dt>ΑΦΜ / VAT</dt><dd>EL<%= company.vat %><% if (company.taxOffice) { %> · <%= company.taxOffice %><% } %></dd><% } %>
    <% if (company.mhte) { %><dt>Αρ. Μητρώου ΜΗΤΕ</dt><dd><%= company.mhte %></dd><% } %>
    <dt>Αρμόδια αρχή</dt><dd><%= company.authority %></dd>
    <% if (company.phone) { %><dt>Τηλέφωνο</dt><dd><a href="tel:<%= company.phone.replace(/\s/g, '') %>"><%= company.phone %></a></dd><% } %>
    <% if (company.email) { %><dt>Email</dt><dd><a href="mailto:<%= company.email %>"><%= company.email %></a></dd><% } %>
  </dl>
  <p><a href="/terms">Όροι ενοικίασης</a> · <a href="/privacy">Πολιτική απορρήτου</a> · <a href="/complaints">Παράπονα & επίλυση διαφορών</a></p>
</div>
<%- include('../partials/footer') %>
