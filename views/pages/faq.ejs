<%- include('../partials/header') %>
<div class="container section prose">
  <h1><%= t('Συχνές ερωτήσεις') %></h1>
  <details open><summary><%= t('Τι χρειάζομαι για να παραλάβω το αυτοκίνητο;') %></summary>
    <p><%= t('Δίπλωμα οδήγησης σε ισχύ (τουλάχιστον {years} έτους), ταυτότητα ή διαβατήριο και πιστωτική κάρτα στο όνομα του οδηγού για την εγγύηση. Για διπλώματα εκτός ΕΕ μπορεί να χρειαστεί Διεθνής Άδεια Οδήγησης.', { years: config.rules.minLicenseYears }) %></p></details>
  <details><summary><%= t('Η τιμή που βλέπω είναι η τελική;') %></summary>
    <p><%- th('Ναι. Περιλαμβάνει ΦΠΑ, υποχρεωτική ασφάλιση αστικής ευθύνης, βασική κάλυψη ζημιών (CDW) με απαλλαγή, τα χιλιόμετρα που αναγράφονται σε κάθε αυτοκίνητο και τυχόν χρεώσεις σημείου παραλαβής. Επιπλέον χρεώνονται μόνο τα πρόσθετα που επιλέγετε και, μετά την επιστροφή, μόνο οι χρεώσεις του <a href="{url}">τιμοκαταλόγου</a> (π.χ. καύσιμο που λείπει).', { url: u('/terms#tariff') }) %></p></details>
  <details><summary><%= t('Πώς υπολογίζονται οι ημέρες;') %></summary>
    <p><%= t('Ανά 24ωρο από την ώρα παραλαβής. Π.χ. παραλαβή Δευτέρα 10:00 και επιστροφή Τετάρτη 10:00 = 2 ημέρες. Έχετε περιθώριο {minutes} λεπτών χωρίς επιπλέον χρέωση.', { minutes: config.rules.graceMinutes }) %></p></details>
  <details><summary><%= t('Μπορώ να ακυρώσω την κράτηση;') %></summary>
    <p><%- th('Ναι, δωρεάν έως {hours} ώρες πριν την παραλαβή, από τη σελίδα <a href="{url}">«Η κράτησή μου»</a>· αν πληρώσατε με κάρτα, το ποσό επιστρέφεται αυτόματα. Μετά το όριο αυτό (ή σε μη εμφάνιση) παρακρατείται η χρέωση ακύρωσης που αναγράφεται στην κράτησή σας. Δεν υφίσταται δικαίωμα υπαναχώρησης 14 ημερών, επειδή η ενοικίαση αφορά συγκεκριμένες ημερομηνίες.', { hours: config.rules.freeCancellationHours, url: u('/manage') }) %></p></details>
  <details><summary><%= t('Τι είναι η εγγύηση;') %></summary>
    <p><%- th('Ένα ποσό που δεσμεύεται (δεν χρεώνεται) σε <strong>πιστωτική</strong> κάρτα στο όνομα του κύριου οδηγού (όχι χρεωστική ή προπληρωμένη), στο γραφείο ή online πριν την παραλαβή. Αποδεσμεύεται μετά την επιστροφή· ο χρόνος εμφάνισης του ποσού εξαρτάται από την τράπεζά σας. Από την εγγύηση αφαιρούνται μόνο οι χρεώσεις του τιμοκαταλόγου και, για ζημιά, μόνο με τη συναίνεσή σας. Με την «Πλήρη Απαλλαγή (FDW)» η συμμετοχή σας σε ζημιές μηδενίζεται· το ποσό της εγγύησης δεν αλλάζει.') %></p></details>
  <details><summary><%= t('Μπορεί να οδηγεί και δεύτερο άτομο;') %></summary>
    <p><%= t('Ναι, προσθέστε «Επιπλέον οδηγό» στην κράτηση. Θα πρέπει να είναι παρών στην παραλαβή με το δίπλωμά του.') %></p></details>
  <details><summary><%= t('Μπορώ να πάρω το αυτοκίνητο σε νησί;') %></summary>
    <p><%= t('Μόνο με γραπτή άδειά μας. Επικοινωνήστε μαζί μας πριν την κράτηση.') %></p></details>
  <details><summary><%= t('Τι γίνεται αν καθυστερήσει η πτήση μου;') %></summary>
    <p><%= t('Δηλώστε τον αριθμό πτήσης στην κράτηση ώστε να παρακολουθούμε την άφιξή σας και να σας περιμένουμε.') %></p></details>
  <details><summary><%= t('Ποιους τρόπους πληρωμής δέχεστε;') %></summary>
    <%- include('../partials/payment-means') %></details>
  <details><summary><%= t('Πώς υποβάλλω παράπονο;') %></summary>
    <p><%- th('Από τη σελίδα <a href="{url}">«Παράπονα & επίλυση διαφορών»</a>. Επιβεβαιώνουμε τη λήψη εντός 2 εργάσιμων και απαντάμε αιτιολογημένα εντός 15 ημερών.', { url: u('/complaints') }) %></p></details>
</div>
<%- include('../partials/footer') %>
