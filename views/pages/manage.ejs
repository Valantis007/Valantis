<%- include('../partials/header') %>
<div class="container section narrow">
  <h1>Διαχείριση κράτησης</h1>
  <p>Συμπληρώστε τον κωδικό κράτησης (θα τον βρείτε στο email επιβεβαίωσης) και το email που δηλώσατε.</p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="/manage" class="card pad stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <div class="field">
      <label for="reference">Κωδικός κράτησης</label>
      <input id="reference" name="reference" value="<%= values.reference || '' %>" required maxlength="8" autocomplete="off" class="uppercase" placeholder="π.χ. AB12CD34">
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= values.email || '' %>" required autocomplete="email">
    </div>
    <button class="btn btn-primary" type="submit">Εύρεση κράτησης</button>
  </form>
  <% if (!user) { %><p class="muted small">Έχετε λογαριασμό; <a href="/login">Συνδεθείτε</a> για να δείτε όλες τις κρατήσεις σας.</p><% } %>
</div>
<%- include('../partials/footer') %>
