<%- include('../partials/header') %>
<div class="container section prose">
  <h1><%= t('Παράπονα & επίλυση διαφορών') %></h1>
  <p><%= t('Αν δεν είστε ικανοποιημένοι από την εξυπηρέτησή μας ή διαφωνείτε με μια χρέωση, πείτε μας:') %></p>
  <ul>
    <li><%- th('με τη <a href="{url}">φόρμα παραπόνων</a> (επιλέξτε «Παράπονο» ή «Αμφισβήτηση χρέωσης» και γράψτε τον κωδικό κράτησης),', { url: u('/contact?kind=complaint') }) %></li>
    <% if (company.email) { %><li><%- th('με email στο <a href="mailto:{email}">{email}</a>,', { email: company.email }) %></li><% } %>
    <% if (company.phone) { %><li><%= t('τηλεφωνικά στο {phone},', { phone: company.phone }) %></li><% } %>
    <li><%= company.address ? t('ή στο γραφείο μας ({address}).', { address: company.address }) : t('ή στο γραφείο μας.') %></li>
  </ul>
  <p><strong><%= t('Επιβεβαιώνουμε τη λήψη εντός 2 εργάσιμων ημερών και απαντάμε αιτιολογημένα εντός 15 ημερών.') %></strong></p>
  <p><%- th('Για χρεώσεις ζημιάς μπορείτε επίσης να απαντήσετε (αποδοχή ή αμφισβήτηση) απευθείας από τη σελίδα <a href="{url}">«Η κράτησή μου»</a>.', { url: u('/manage') }) %></p>
  <h2><%= t('Εξωδικαστική επίλυση') %></h2>
  <p><%- th('Αν δεν βρεθεί λύση, μπορείτε να απευθυνθείτε στον <strong>Συνήγορο του Καταναλωτή</strong> (www.synigoroskatanaloti.gr), φορέα Εναλλακτικής Επίλυσης Διαφορών.') %> <%= company.adrCommitment ? t('Η εταιρεία δεσμεύεται να συμμετέχει στη διαδικασία.') : t('Η εταιρεία εξετάζει κατά περίπτωση τη συμμετοχή της στη διαδικασία.') %>
    <%= t('Καταναλωτές από άλλα κράτη της ΕΕ μπορούν να ζητήσουν συνδρομή από το Ευρωπαϊκό Κέντρο Καταναλωτή Ελλάδας (www.eccgreece.gr).') %></p>
</div>
<%- include('../partials/footer') %>
