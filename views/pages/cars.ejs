<%- include('../partials/header') %>
<section class="search-bar">
  <div class="container">
    <% if (search.ok) {
         const pickupPlace = locations.find(function (l) { return String(l.id) === String(search.values.pickup_location); });
         const returnPlace = locations.find(function (l) { return String(l.id) === String(search.values.return_location); }); %>
      <details class="search-toggle" open data-mobile-collapsed>
        <summary>
          <span><% if (pickupPlace) { %><strong><%= tf(pickupPlace, 'name') %><% if (returnPlace && returnPlace.id !== pickupPlace.id) { %> → <%= tf(returnPlace, 'name') %><% } %></strong><br><% } %><%= format.dateTime(search.pickupAt) %> → <%= format.dateTime(search.returnAt) %></span>
          <span class="search-toggle-edit"><%= t('Αλλαγή') %></span>
        </summary>
        <%- include('../partials/search-form', { locations, values: searchValues, errors, compact: true, buttonLabel: 'Ενημέρωση', keep: { category: filters.category, transmission: filters.transmission, seats: filters.seats, sort: filters.sort === 'price_asc' ? '' : filters.sort } }) %>
      </details>
    <% } else { %>
      <%- include('../partials/search-form', { locations, values: searchValues, errors, compact: true, buttonLabel: 'Ενημέρωση', keep: { category: filters.category, transmission: filters.transmission, seats: filters.seats, sort: filters.sort === 'price_asc' ? '' : filters.sort } }) %>
    <% } %>
  </div>
</section>
<div class="container section layout-sidebar">
  <aside class="filters card">
    <details open data-mobile-collapsed>
    <summary class="h4"><%= t('Φίλτρα') %><% const activeFilters = ['category', 'transmission', 'seats'].filter(function (k) { return filters[k]; }).length; %><% if (activeFilters) { %> <span class="count-badge"><%= activeFilters %></span><% } %></summary>
    <form method="get" action="<%= u('/cars') %>" data-autosubmit autocomplete="off">
      <% ['pickup_location','return_location','pickup_date','pickup_time','return_date','return_time'].forEach(function (k) { if (search.values[k] && search.provided) { %>
        <input type="hidden" name="<%= k %>" value="<%= search.values[k] %>">
      <% } }) %>
      <div class="field">
        <label for="f-category"><%= t('Κατηγορία') %></label>
        <select id="f-category" name="category">
          <option value=""><%= t('Όλες') %></option>
          <% categories.forEach(function (c) { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= format.label('category', c) %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="f-transmission"><%= t('Κιβώτιο') %></label>
        <select id="f-transmission" name="transmission">
          <option value=""><%= t('Όλα') %></option>
          <option value="manual" <%= filters.transmission === 'manual' ? 'selected' : '' %>><%= t('Χειροκίνητο') %></option>
          <option value="automatic" <%= filters.transmission === 'automatic' ? 'selected' : '' %>><%= t('Αυτόματο') %></option>
        </select>
      </div>
      <div class="field">
        <label for="f-seats"><%= t('Θέσεις (τουλάχιστον)') %></label>
        <select id="f-seats" name="seats">
          <option value=""><%= t('Όλα') %></option>
          <% [4,5,7,9].forEach(function (n) { %><option value="<%= n %>" <%= filters.seats === n ? 'selected' : '' %>><%= n %>+</option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="f-sort"><%= t('Ταξινόμηση') %></label>
        <select id="f-sort" name="sort">
          <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>><%= t('Τιμή: χαμηλή → υψηλή') %></option>
          <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>><%= t('Τιμή: υψηλή → χαμηλή') %></option>
          <option value="seats" <%= filters.sort === 'seats' ? 'selected' : '' %>><%= t('Περισσότερες θέσεις') %></option>
        </select>
      </div>
      <button class="btn btn-block" type="submit"><%= t('Εφαρμογή') %></button>
    </form>
    </details>
  </aside>

  <section>
    <% if (search.ok) { %>
      <p class="results-summary">
        <% const days = time.rentalDays(search.pickupAt, search.returnAt); %><%- th(cars.length === 1 && locale !== 'el' ? '<strong>{count}</strong> διαθέσιμο αυτοκίνητο' : '<strong>{count}</strong> διαθέσιμα αυτοκίνητα', { count: cars.length }) %> <%- th(days === 1 && locale !== 'el' ? 'για <strong>{days} ημέρα</strong>' : 'για <strong>{days} ημέρες</strong>', { days }) %>
        · <%= format.dateTime(search.pickupAt) %> → <%= format.dateTime(search.returnAt) %>
        <% if (unavailableCount) { %><span class="muted">(<%= t('{n} δεν είναι διαθέσιμα', { n: unavailableCount }) %>)</span><% } %>
      </p>
          <%- include('../partials/payment-means') %>
    <% } else { %>
      <div class="alert alert-info"><%= t('Επιλέξτε σημείο και ημερομηνίες για να δείτε διαθεσιμότητα και τελικές τιμές.') %></div>
    <% } %>

    <% if (!cars.length) { %>
      <div class="empty card">
        <h2 class="h4"><%= t('Δεν βρέθηκαν διαθέσιμα αυτοκίνητα') %></h2>
        <p><%= t('Δοκιμάστε διαφορετικές ημερομηνίες ή αφαιρέστε κάποιο φίλτρο.') %></p>
      </div>
    <% } %>

    <div class="car-list">
      <% cars.forEach(function (car) { %>
        <article class="card car-row">
          <a href="<%= u(`/cars/${car.id}`) %><%= search.ok ? `?${query}` : '' %>" class="car-image"><img src="<%= car.image || `/img/cars/${car.category}.svg` %>" alt="<%= car.make %> <%= car.model %>" loading="lazy"></a>
          <div class="car-body">
            <span class="badge"><%= format.label('category', car.category) %></span>
            <h2 class="h3"><a href="<%= u(`/cars/${car.id}`) %><%= search.ok ? `?${query}` : '' %>"><%= car.make %> <%= car.model %></a> <span class="muted small"><%= t('ή παρόμοιο') %></span></h2>
            <%- include('../partials/car-specs', { car }) %>
            <p class="small muted"><%= t('Ελάχιστη ηλικία οδηγού {age}', { age: car.min_driver_age }) %> · <%= t(car.mileage_policy) %> · <%= t('Απαλλαγή {amount}', { amount: format.money(car.excess_cents ?? car.deposit_cents) }) %> · <%= t('Εγγύηση {amount} (πιστωτική κάρτα)', { amount: format.money(car.deposit_cents) }) %></p>
          </div>
          <div class="car-price">
            <% if (car.quote) { %>
              <div class="total"><%= format.money(car.quote.totalCents) %></div>
              <div class="small muted"><%= t(car.quote.days === 1 ? 'σύνολο για {n} ημέρα' : 'σύνολο για {n} ημέρες', { n: car.quote.days }) %></div>
              <div class="small"><%= t('{price} / ημέρα', { price: format.money(car.quote.avgDailyCents) }) %></div>
              <% if (car.quote.discountPercent) { %><div class="small success"><%= t('-{percent}% έκπτωση διάρκειας', { percent: car.quote.discountPercent }) %></div><% } %>
              <a class="btn btn-primary" href="<%= u(`/booking/new?car_id=${car.id}`) %>&<%= query %>"><%= t('Κράτηση') %></a>
            <% } else { %>
              <div class="total"><%= t('από {price}', { price: format.money(car.daily_rate_cents) }) %></div>
              <div class="small muted"><%= t('ανά ημέρα') %></div>
              <a class="btn" href="<%= u(`/cars/${car.id}`) %>"><%= t('Λεπτομέρειες') %></a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</div>
<%- include('../partials/footer') %>
