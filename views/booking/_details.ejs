<div class="card pad">
  <div class="booking-head">
    <img src="<%= booking.image || `/img/cars/${booking.category}.svg` %>" alt="" class="thumb">
    <div>
      <h2 class="h3"><%= booking.make %> <%= booking.model %> <span class="muted small">ή παρόμοιο</span></h2>
      <p class="small muted"><%= format.label('category', booking.category) %> · <%= format.label('transmission', booking.transmission) %> · <%= format.label('fuel', booking.fuel) %></p>
    </div>
  </div>
  <dl class="trip">
    <div><dt>Παραλαβή</dt><dd><strong><%= format.dateTime(booking.pickup_at) %></strong><br><%= booking.pickup_location_name %><br><span class="muted small"><%= booking.pickup_location_address %></span></dd></div>
    <div><dt>Επιστροφή</dt><dd><strong><%= format.dateTime(booking.return_at) %></strong><br><%= booking.return_location_name %><br><span class="muted small"><%= booking.return_location_address %></span></dd></div>
  </dl>
  <h3 class="h4">Οδηγός</h3>
  <p><%= booking.first_name %> <%= booking.last_name %> · <%= booking.email %> · <%= booking.phone %><% if (booking.flight_number) { %><br>Πτήση/πλοίο: <%= booking.flight_number %><% } %></p>
  <h3 class="h4">Χρέωση</h3>
  <dl class="quote">
    <div><dt>Ενοικίαση (<%= booking.days %> <%= booking.days === 1 ? 'ημέρα' : 'ημέρες' %>)</dt><dd><%= format.money(booking.base_cents) %></dd></div>
    <% if (booking.discount_cents) { %><div><dt>Έκπτωση διάρκειας</dt><dd class="success">-<%= format.money(booking.discount_cents) %></dd></div><% } %>
    <% if (booking.fees_cents) { %><div><dt>Χρεώσεις σημείου</dt><dd><%= format.money(booking.fees_cents) %></dd></div><% } %>
    <% extras.forEach(function (x) { %><div><dt><%= x.name %><%= x.qty > 1 ? ` ×${x.qty}` : '' %></dt><dd><%= format.money(x.total_cents) %></dd></div><% }) %>
    <div class="total-row"><dt>Σύνολο</dt><dd><%= format.money(booking.total_cents) %></dd></div>
    <div class="small muted"><dt>Περιλαμβάνεται ΦΠΑ</dt><dd><%= format.money(booking.vat_cents) %></dd></div>
    <div class="small muted"><dt>Εγγύηση στην παραλαβή</dt><dd><%= format.money(booking.deposit_cents) %></dd></div>
  </dl>
  <p class="small">Τρόπος πληρωμής: <strong><%= format.label('paymentMethod', booking.payment_method) %></strong> · Κατάσταση πληρωμής: <strong><%= format.label('paymentStatus', booking.payment_status) %></strong>
  <% if (booking.refunded_cents) { %> · Επιστράφηκαν: <strong><%= format.money(booking.refunded_cents) %></strong><% } %></p>
</div>
