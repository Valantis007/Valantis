<div class="card pad">
  <div class="booking-head">
    <img src="<%= booking.image || `/img/cars/${booking.category}.svg` %>" alt="" class="thumb">
    <div>
      <h2 class="h3"><%= booking.make %> <%= booking.model %> <span class="muted small"><%= t('ή παρόμοιο') %></span></h2>
      <p class="small muted"><%= format.label('category', booking.category) %> · <%= format.label('transmission', booking.transmission) %> · <%= format.label('fuel', booking.fuel) %> · <%= format.mileage(booking) %></p>
    </div>
  </div>
  <dl class="trip">
    <div><dt><%= t('Παραλαβή') %></dt><dd><strong><%= format.dateTime(booking.pickup_at) %></strong><br><%= tf(booking, 'pickup_location_name') %><br>
      <% if (booking.pickup_address) { %><strong class="small" data-customer-address="pickup"><%= t('Διεύθυνση παράδοσης: {address}', { address: places.shownAddress(booking.pickup_address, t) }) %></strong><% } else { %><span class="muted small"><%= tf(booking, 'pickup_location_address') %></span><% } %></dd></div>
    <div><dt><%= t('Επιστροφή') %></dt><dd><strong><%= format.dateTime(booking.return_at) %></strong><br><%= tf(booking, 'return_location_name') %><br>
      <% if (booking.return_address) { %><strong class="small" data-customer-address="return"><%= t('Θα παραλάβουμε το αυτοκίνητο από: {address}', { address: places.shownAddress(booking.return_address, t) }) %></strong><% } else { %><span class="muted small"><%= tf(booking, 'return_location_address') %></span><% } %></dd></div>
  </dl>
  <h3 class="h4"><%= t('Οδηγός') %></h3>
  <p><%= booking.first_name %> <%= booking.last_name %> · <%= booking.email %> · <%= booking.phone %><% if (booking.flight_number) { %><br><%= t('Πτήση/πλοίο') %>: <%= booking.flight_number %><% } %></p>
  <h3 class="h4"><%= t('Χρέωση') %></h3>
  <dl class="quote">
    <div><dt><%= booking.days === 1 ? t('Ενοικίαση ({days} ημέρα)', { days: booking.days }) : t('Ενοικίαση ({days} ημέρες)', { days: booking.days }) %></dt><dd><%= format.money(booking.base_cents) %></dd></div>
    <% if (booking.discount_cents) { %><div><dt><%= t('Έκπτωση διάρκειας') %></dt><dd class="success">-<%= format.money(booking.discount_cents) %></dd></div><% } %>
    <% if (booking.fees_cents) { %><div><dt><%= t('Χρεώσεις σημείου') %></dt><dd><%= format.money(booking.fees_cents) %></dd></div><% } %>
    <% extras.forEach(function (x) { %><div><dt><%= tf(x, 'name') %><%= x.qty > 1 ? ` ×${x.qty}` : '' %></dt><dd><%= format.money(x.total_cents) %></dd></div><% }) %>
    <div class="total-row"><dt><%= t('Σύνολο') %></dt><dd><%= format.money(booking.total_cents) %></dd></div>
    <div class="small muted"><dt><%= t('Περιλαμβάνεται ΦΠΑ') %></dt><dd><%= format.money(booking.vat_cents) %></dd></div>
    <div class="small muted"><dt><%= t('Εγγύηση στην παραλαβή') %></dt><dd><%= format.money(booking.deposit_cents) %></dd></div>
  </dl>
  <p class="small"><%= t('Τρόπος πληρωμής') %>: <strong><%= format.label('paymentMethod', booking.payment_method) %></strong> · <%= t('Κατάσταση πληρωμής') %>: <strong><%= format.label('paymentStatus', booking.payment_status) %></strong>
  <% if (booking.refunded_cents) { %> · <%= t('Επιστράφηκαν') %>: <strong><%= format.money(booking.refunded_cents) %></strong><% } %></p>
</div>
