<dl class="quote" data-quote>
  <div><dt>Ενοικίαση (<span data-q="days"><%= quote.days %></span> <%= quote.days === 1 ? 'ημέρα' : 'ημέρες' %>)</dt><dd data-q="base"><%= format.money(quote.baseCents) %></dd></div>
  <div class="<%= quote.discountCents ? '' : 'hidden' %>" data-q-row="discount"><dt>Έκπτωση διάρκειας (<span data-q="discountPercent"><%= quote.discountPercent %></span>%)</dt><dd class="success" data-q="discount">-<%= format.money(quote.discountCents) %></dd></div>
  <% quote.feeLines.forEach(function (f) { %><div><dt><%= f.name %></dt><dd><%= format.money(f.cents) %></dd></div><% }) %>
  <div class="<%= quote.extrasCents ? '' : 'hidden' %>" data-q-row="extras"><dt>Πρόσθετα</dt><dd data-q="extras"><%= format.money(quote.extrasCents) %></dd></div>
  <div class="total-row"><dt>Σύνολο</dt><dd data-q="total"><%= format.money(quote.totalCents) %></dd></div>
  <div class="small muted"><dt>Περιλαμβάνεται ΦΠΑ</dt><dd data-q="vat"><%= format.money(quote.vatCents) %></dd></div>
  <div class="small muted"><dt>Εγγύηση (δέσμευση στην παραλαβή)</dt><dd><%= format.money(quote.depositCents) %></dd></div>
</dl>
