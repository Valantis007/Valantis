<%- include('../partials/header') %>
<div class="container section narrow-wide">
  <div class="section-head">
    <div>
      <h1>Κράτηση <span class="ref"><%= booking.reference %></span></h1>
      <span class="status status-<%= booking.status %>"><%= format.label('status', booking.status) %></span>
    </div>
    <a class="btn" href="/booking/<%= booking.reference %>/print" target="_blank">Εκτύπωση</a>
  </div>

  <% if (booking.status === 'pending_payment') { %>
    <div class="alert alert-warning">
      Η κράτηση δεν έχει ολοκληρωθεί — εκκρεμεί η πληρωμή.
      <% if (canPay) { %>Το αυτοκίνητο είναι δεσμευμένο για εσάς έως τις <strong><%= new Date(booking.hold_expires_at).toLocaleTimeString('el-GR', { timeZone: config.rules.timezone, hour: '2-digit', minute: '2-digit' }) %></strong>.<% } %>
    </div>
    <% if (canPay) { %>
      <form method="post" action="/booking/<%= booking.reference %>/pay" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button class="btn btn-primary" type="submit">Πληρωμή <%= format.money(booking.total_cents) %></button>
      </form>
    <% } %>
  <% } else if (booking.status === 'expired') { %>
    <div class="alert alert-error">Η κράτηση έληξε επειδή δεν ολοκληρώθηκε η πληρωμή. <a href="/cars">Κάντε νέα αναζήτηση</a>.</div>
  <% } else if (booking.status === 'confirmed') { %>
    <div class="alert alert-success">Η κράτησή σας είναι επιβεβαιωμένη. Σας περιμένουμε στις <strong><%= format.dateTime(booking.pickup_at) %></strong> στο σημείο «<%= booking.pickup_location_name %>».</div>
  <% } %>

  <%- include('_details', { booking, extras }) %>

  <% if (pendingRefundCents) { %>
    <div class="alert alert-info">Επιστροφή <%= format.money(pendingRefundCents) %> στην κάρτα σας είναι σε εξέλιξη.</div>
  <% } %>

  <% if (deposit && ['held', 'released', 'captured'].includes(deposit.status)) { %>
    <div class="card pad">
      <h2 class="h4">Εγγύηση</h2>
      <p><%= format.money(deposit.amount_cents) %> · <strong><%= format.label('depositStatus', deposit.status) %></strong><% if (deposit.card_last4) { %> · κάρτα •••• <%= deposit.card_last4 %><% } %></p>
      <% if (deposit.status === 'captured') { %><p class="small">Παρακρατήθηκαν <%= format.money(deposit.captured_cents) %>, αποδεσμεύτηκαν <%= format.money(deposit.amount_cents - deposit.captured_cents) %>.</p><% } %>
    </div>
  <% } %>

  <% if (charges.length) { %>
    <div class="card pad">
      <h2 class="h4">Χρεώσεις μετά την επιστροφή</h2>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Χρέωση</th><th>Ποσό</th><th>Κατάσταση</th></tr></thead>
          <tbody>
            <% charges.forEach(function (c) { %>
              <tr>
                <td><strong><%= format.label('chargeCategory', c.category) %></strong><br><%= c.description %>
                  <% if (c.evidence) { %><br><span class="small muted">Τεκμηρίωση: <%= c.evidence %></span><% } %></td>
                <td><%= format.money(c.amount_cents) %><% if (c.paid_cents && c.paid_cents < c.amount_cents) { %><br><span class="small muted">εξοφλήθηκαν <%= format.money(c.paid_cents) %></span><% } %></td>
                <td><%= format.label('chargeStatus', c.status) %></td>
              </tr>
              <% if (c.status === 'proposed') { %>
                <tr><td colspan="3">
                  <p class="small">Παρακαλούμε απαντήστε έως <strong><%= format.date(c.respond_by) %></strong>. Αν διαφωνείτε, πατήστε «Αμφισβήτηση» και περιγράψτε τον λόγο — θα επικοινωνήσουμε μαζί σας.</p>
                  <div class="inline-grid">
                    <form method="post" action="/booking/<%= booking.reference %>/charges/<%= c.id %>/respond" class="stack grow" data-confirm="Αποδέχεστε τη χρέωση <%= format.money(c.amount_cents) %>;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <input type="hidden" name="decision" value="accept">
                      <label class="check"><input type="checkbox" name="confirm" value="1" required><span>Αποδέχομαι τη χρέωση <%= format.money(c.amount_cents) %> για «<%= c.description %>».</span></label>
                      <button class="btn btn-primary" type="submit">Αποδοχή</button>
                    </form>
                    <form method="post" action="/booking/<%= booking.reference %>/charges/<%= c.id %>/respond" class="stack grow">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <input type="hidden" name="decision" value="dispute">
                      <textarea name="note" rows="2" placeholder="Γιατί διαφωνείτε;" required></textarea>
                      <button class="btn" type="submit">Αμφισβήτηση</button>
                    </form>
                  </div>
                </td></tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (outstanding > 0) { %>
        <p>Υπόλοιπο προς πληρωμή: <strong><%= format.money(outstanding) %></strong></p>
        <% if (canPayCharges) { %>
          <form method="post" action="/booking/<%= booking.reference %>/charges/pay">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <button class="btn btn-primary" type="submit">Πληρωμή <%= format.money(outstanding) %></button>
          </form>
        <% } %>
      <% } %>
    </div>
  <% } %>

  <% if (['confirmed', 'pending_payment'].includes(booking.status)) { %>
    <div class="card pad">
      <h2 class="h4">Τι να έχετε μαζί σας</h2>
      <ul class="checklist">
        <li>Δίπλωμα οδήγησης (και Διεθνή Άδεια για διπλώματα εκτός ΕΕ)</li>
        <li>Ταυτότητα ή διαβατήριο</li>
        <li>Πιστωτική κάρτα στο όνομα του οδηγού για την εγγύηση</li>
        <li>Τον κωδικό κράτησης <strong><%= booking.reference %></strong></li>
      </ul>
    </div>
    <div class="card pad">
      <h2 class="h4">Ακύρωση</h2>
      <% if (cancellation.allowed) { %>
        <% if (cancellation.late && cancellation.feeCents > 0) { %>
          <p>Είμαστε εντός <%= config.rules.freeCancellationHours %> ωρών πριν την παραλαβή: ισχύει η <strong>χρέωση ακύρωσης <%= format.money(cancellation.feeCents) %></strong> που γνωστοποιήθηκε στην κράτηση. Θα επιστραφούν <strong><%= format.money(booking.paid_cents - booking.refunded_cents - cancellation.feeCents) %></strong>.</p>
        <% } else if (cancellation.late) { %>
          <p>Μπορείτε να ακυρώσετε χωρίς χρέωση, επειδή δεν έχετε προπληρώσει.</p>
        <% } else { %>
          <p>Μπορείτε να ακυρώσετε δωρεάν.<% if (booking.paid_cents && booking.payment_ref) { %> Το ποσό που πληρώσατε επιστρέφεται αυτόματα στην κάρτα σας.<% } else if (booking.paid_cents) { %> Θα επικοινωνήσουμε μαζί σας για την επιστροφή του ποσού που πληρώσατε.<% } %></p>
        <% } %>
        <form method="post" action="/booking/<%= booking.reference %>/cancel" class="stack" data-confirm="Σίγουρα θέλετε να ακυρώσετε την κράτηση;">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <% if (cancellation.late && cancellation.feeCents > 0) { %>
            <label class="check"><input type="checkbox" name="accept_fee" value="1" required><span>Αποδέχομαι τη χρέωση ακύρωσης <%= format.money(cancellation.feeCents) %>.</span></label>
          <% } %>
          <button class="btn btn-danger" type="submit">Ακύρωση κράτησης</button>
        </form>
      <% } else { %>
        <p class="muted"><%= cancellation.reason %></p>
      <% } %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
