<%# Παράμετροι: locations, values, errors, compact (προαιρετικό), action (προαιρετικό) %>
<% const v = values || {}; const e = errors || {}; const slots = time.timeSlots(); %>
<form class="search-form <%= locals.stacked ? 'stacked' : '' %>" method="get" action="<%= locals.action || '/cars' %>" data-search-form>
  <div class="field">
    <label for="pickup_location">Σημείο παραλαβής</label>
    <select id="pickup_location" name="pickup_location" required>
      <option value="">Επιλέξτε...</option>
      <% locations.forEach(function (l) { %>
        <option value="<%= l.id %>" <%= String(v.pickup_location) === String(l.id) ? 'selected' : '' %>><%= l.name %><%= l.fee_cents ? ` (+${format.money(l.fee_cents)})` : '' %></option>
      <% }) %>
    </select>
    <% if (e.pickup_location) { %><span class="error"><%= e.pickup_location %></span><% } %>
  </div>
  <div class="field">
    <label for="return_location">Σημείο επιστροφής</label>
    <select id="return_location" name="return_location">
      <option value="">Ίδιο με παραλαβή</option>
      <% locations.forEach(function (l) { %>
        <option value="<%= l.id %>" <%= v.return_location && String(v.return_location) === String(l.id) ? 'selected' : '' %>><%= l.name %></option>
      <% }) %>
    </select>
    <% if (e.return_location) { %><span class="error"><%= e.return_location %></span><% } %>
  </div>
  <div class="field date-time">
    <label for="pickup_date">Παραλαβή</label>
    <div class="row-inline">
      <input type="date" id="pickup_date" name="pickup_date" value="<%= v.pickup_date %>" required>
      <select name="pickup_time" aria-label="Ώρα παραλαβής">
        <% slots.forEach(function (s) { %><option <%= v.pickup_time === s ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </div>
    <% if (e.pickup_date || e.pickup_time) { %><span class="error"><%= e.pickup_date || e.pickup_time %></span><% } %>
  </div>
  <div class="field date-time">
    <label for="return_date">Επιστροφή</label>
    <div class="row-inline">
      <input type="date" id="return_date" name="return_date" value="<%= v.return_date %>" required>
      <select name="return_time" aria-label="Ώρα επιστροφής">
        <% slots.forEach(function (s) { %><option <%= v.return_time === s ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </div>
    <% if (e.return_date || e.return_time) { %><span class="error"><%= e.return_date || e.return_time %></span><% } %>
  </div>
  <div class="field submit">
    <button type="submit" class="btn btn-primary"><%= locals.buttonLabel || 'Αναζήτηση' %></button>
  </div>
</form>
