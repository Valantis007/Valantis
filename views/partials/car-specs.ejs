<%# Στα ελληνικά η διατύπωση μένει όπως ήταν («1 βαλίτσες»)· στις άλλες γλώσσες ενικός για 1. -%>
<ul class="specs">
  <li title="<%= t('Θέσεις') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg><%= t('{n} θέσεις', { n: car.seats }) %></li>
  <li title="<%= t('Κιβώτιο') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4a2 2 0 0 1 1 3.7V11h5V7.7a2 2 0 1 1 2 0V11h5V7.7a2 2 0 1 1 2 0V13h-7v3.3a2 2 0 1 1-2 0V13H6v3.3a2 2 0 1 1-2 0V7.7A2 2 0 0 1 5 4z"/></svg><%= format.label('transmission', car.transmission) %></li>
  <li title="<%= t('Καύσιμο') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h9v8h1a2 2 0 0 1 2 2v4a1 1 0 0 0 2 0V9l-2-2 1.4-1.4L20 8.2V17a3 3 0 0 1-6 0v-4h-1v8H4zm2 2v4h5V5z"/></svg><%= format.label('fuel', car.fuel) %></li>
  <li title="<%= t('Αποσκευές') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 2h6v4h3a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3zm2 2v2h2V4z"/></svg><%= t(car.luggage === 1 ? '{n} βαλίτσα' : '{n} βαλίτσες', { n: car.luggage }) %></li>
  <% if (locals.full) { %>
    <li title="<%= t('Πόρτες') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18H5zm9 8v2h2v-2z"/></svg><%= t('{n} πόρτες', { n: car.doors }) %></li>
    <% if (car.air_conditioning) { %><li title="<%= t('Κλιματισμός') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 2h2v4.6l3-3 1.4 1.4L13 9.4V11h1.6L19 6.6 20.4 8l-3 3H22v2h-4.6l3 3-1.4 1.4-4.4-4.4H13v1.6l4.4 4.4-1.4 1.4-3-3V22h-2v-4.6l-3 3L6.6 19l4.4-4.4V13H9.4L5 17.4 3.6 16l3-3H2v-2h4.6l-3-3L5 6.6 9.4 11H11V9.4L6.6 5 8 3.6l3 3z"/></svg><%= t('Κλιματισμός') %></li><% } %>
  <% } %>
</ul>
