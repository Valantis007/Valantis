<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} | ${company.name}` : company.name %></title>
  <meta name="description" content="<%= company.name %> - Ενοικίαση αυτοκινήτων με online κράτηση, διαφανείς τιμές και δωρεάν ακύρωση.">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script src="/js/app.js" defer></script>
</head>
<body class="<%= locals.bodyClass || '' %>">
  <a class="skip-link" href="#main">Μετάβαση στο περιεχόμενο</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M6 19l2.4-6.2A3 3 0 0 1 11.2 11h9.6a3 3 0 0 1 2.8 1.8L26 19h1a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-2a3 3 0 0 1-6 0h-6a3 3 0 0 1-6 0H5a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1zm2.2 0h15.6l-2-5.1a1 1 0 0 0-1-.7h-9.6a1 1 0 0 0-1 .7z"/></svg>
        <span><%= company.name %></span>
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Μενού">
      <label for="nav-toggle" class="nav-toggle-label" aria-hidden="true"><span></span></label>
      <nav class="main-nav" aria-label="Κύριο μενού">
        <a href="/cars" class="<%= currentPath.startsWith('/cars') ? 'active' : '' %>">Στόλος</a>
        <a href="/manage" class="<%= currentPath === '/manage' ? 'active' : '' %>">Η κράτησή μου</a>
        <a href="/faq" class="<%= currentPath === '/faq' ? 'active' : '' %>">Συχνές ερωτήσεις</a>
        <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Επικοινωνία</a>
        <% if (user) { %>
          <% if (user.role === 'admin') { %><a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>">Διαχείριση</a><% } %>
          <a href="/account" class="<%= currentPath.startsWith('/account') ? 'active' : '' %>">Λογαριασμός</a>
          <form method="post" action="/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button">Αποσύνδεση</button>
          </form>
        <% } else { %>
          <a href="/login" class="<%= currentPath === '/login' ? 'active' : '' %>">Σύνδεση</a>
          <a href="/register" class="btn btn-small">Εγγραφή</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main id="main">
    <% const flashMessages = takeFlash(); if (flashMessages.length) { %>
      <div class="container flash-stack">
        <% flashMessages.forEach(function (f) { %>
          <div class="alert alert-<%= f.type %>" role="<%= f.type === 'error' ? 'alert' : 'status' %>"><%= f.message %></div>
        <% }) %>
      </div>
    <% } %>
