  </main>
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <strong><%= company.name %></strong>
        <p class="muted small"><%= company.legalName %><% if (company.vat) { %><br><%= t('ΑΦΜ') %> <%= company.vat %><% if (company.taxOffice) { %> · <%= company.taxOffice %><% } %><% } %><% if (company.gemi) { %><br><%= t('ΓΕΜΗ') %> <%= company.gemi %><% } %><% if (company.mhte) { %><br><%= t('ΜΗΤΕ') %> <%= company.mhte %><% } %></p>
      </div>
      <div>
        <strong><%= t('Επικοινωνία') %></strong>
        <p class="small">
          <% if (company.address) { %><%= company.address %><br><% } %>
          <% if (company.phone) { %><a href="tel:<%= company.phone.replace(/\s/g, '') %>"><%= company.phone %></a><br><% } %>
          <% if (company.email) { %><a href="mailto:<%= company.email %>"><%= company.email %></a><% } %>
        </p>
      </div>
      <div>
        <strong><%= t('Πληροφορίες') %></strong>
        <p class="small">
          <a href="<%= u('/terms') %>"><%= t('Όροι ενοικίασης') %></a><br>
          <a href="<%= u('/privacy') %>"><%= t('Πολιτική απορρήτου & cookies') %></a><br>
          <a href="<%= u('/faq') %>"><%= t('Συχνές ερωτήσεις') %></a><br>
          <a href="<%= u('/company') %>"><%= t('Στοιχεία εταιρείας') %></a><br>
          <a href="<%= u('/complaints') %>"><%= t('Παράπονα & επίλυση διαφορών') %></a><% if (locals.hasPhotoCredits) { %><br>
          <a href="<%= u('/photo-credits') %>"><%= t('Πηγές φωτογραφιών') %></a><% } %>
        </p>
      </div>
      <div>
        <strong><%= t('Ωράριο') %></strong>
        <p class="small"><%= t('Καθημερινά {from} - {to}', { from: `${String(config.rules.openingHour).padStart(2, '0')}:00`, to: `${config.rules.closingHour}:00` }) %></p>
      </div>
    </div>
    <div class="container footer-bottom small muted">© <%= new Date().getFullYear() %> <%= String(company.legalName).replace(/\.$/, '') %>. <%= t('Όλες οι τιμές περιλαμβάνουν ΦΠΑ {vat}%.', { vat: config.rules.vatPercent }) %></div>
  </footer>
</body>
</html>
