<table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;margin:12px 0;">
  <tr><td style="color:#6b7280;width:40%;"><%= t('Κωδικός κράτησης') %></td><td><strong style="font-size:18px;letter-spacing:1px;"><%= booking.reference %></strong></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Αυτοκίνητο') %></td><td><%= t('{car} ή παρόμοιο ({category})', { car: `${booking.make} ${booking.model}`, category: format.label('category', booking.category) }) %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Χιλιόμετρα') %></td><td><%= format.mileage(booking) %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Παραλαβή') %></td><td><strong><%= format.dateTime(booking.pickup_at) %></strong><br><%= tf(booking, 'pickup_location_name') %><br><% if (booking.pickup_address) { %><strong><%= t('Διεύθυνση παράδοσης: {address}', { address: booking.pickup_address }) %></strong><% } else { %><span style="color:#6b7280;"><%= tf(booking, 'pickup_location_address') %></span><% } %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Επιστροφή') %></td><td><strong><%= format.dateTime(booking.return_at) %></strong><br><%= tf(booking, 'return_location_name') %><br><% if (booking.return_address) { %><strong><%= t('Θα παραλάβουμε το αυτοκίνητο από: {address}', { address: booking.return_address }) %></strong><% } else { %><span style="color:#6b7280;"><%= tf(booking, 'return_location_address') %></span><% } %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Οδηγός') %></td><td><%= booking.first_name %> <%= booking.last_name %> · <%= booking.phone %></td></tr>
  <% if (locals.extras && extras.length) { %><tr><td style="color:#6b7280;"><%= t('Πρόσθετα') %></td><td><% extras.forEach(function (x) { %><%= tf(x, 'name') %><%= x.qty > 1 ? ` ×${x.qty}` : '' %> (<%= format.money(x.total_cents) %>)<br><% }) %></td></tr><% } %>
  <tr><td style="color:#6b7280;"><%= t(booking.days === 1 ? 'Ενοικίαση ({days} ημέρα)' : 'Ενοικίαση ({days} ημέρες)', { days: booking.days }) %></td><td><%= format.money(booking.base_cents) %></td></tr>
  <% if (booking.discount_cents) { %><tr><td style="color:#6b7280;"><%= t('Έκπτωση διάρκειας') %></td><td>-<%= format.money(booking.discount_cents) %></td></tr><% } %>
  <% if (booking.fees_cents) { %><tr><td style="color:#6b7280;"><%= t('Χρεώσεις σημείου / επιστροφής σε άλλο σημείο') %></td><td><%= format.money(booking.fees_cents) %></td></tr><% } %>
  <tr><td style="color:#6b7280;"><%= t('Σύνολο') %></td><td><%- th('<strong>{total}</strong> (περιλαμβάνεται ΦΠΑ {vat}%: {vatAmount})', { total: format.money(booking.total_cents), vat: config.rules.vatPercent, vatAmount: format.money(booking.vat_cents) }) %></td></tr>
  <% if (booking.paid_cents > 0) { %><tr><td style="color:#6b7280;"><%= t('Πληρώθηκαν') %></td><td><%= format.money(booking.paid_cents) %><% if (booking.refunded_cents) { %> <%= t('(επιστράφηκαν {amount})', { amount: format.money(booking.refunded_cents) }) %><% } %></td></tr><% } else { %><tr><td style="color:#6b7280;"><%= t('Πληρωτέο') %></td><td><%= t('{amount} κατά την παραλαβή', { amount: format.money(booking.total_cents) }) %></td></tr><% } %>
  <tr><td style="color:#6b7280;"><%= t('Απαλλαγή ζημιών') %></td><td><%= format.money(booking.excess_cents ?? booking.deposit_cents) %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Πληρωμή') %></td><td><%= format.label('paymentMethod', booking.payment_method) %> — <%= format.label('paymentStatus', booking.payment_status) %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Εγγύηση') %></td><td><%= t('{amount}: δέσμευση (όχι χρέωση) σε πιστωτική κάρτα στο όνομα του κύριου οδηγού — όχι χρεωστική/προπληρωμένη. Αποδεσμεύεται μετά την επιστροφή.', { amount: format.money(booking.deposit_cents) }) %></td></tr>
</table>
