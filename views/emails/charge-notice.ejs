<%- include('_top') %>
<p><%= t('Αγαπητέ/ή {name},', { name: booking.first_name }) %></p>
<p><%- th('Κατά τον έλεγχο του αυτοκινήτου μετά την επιστροφή (κράτηση <strong>{ref}</strong>) καταγράψαμε την παρακάτω χρέωση, που χρειάζεται την αποδοχή σας:', { ref: booking.reference }) %></p>
<table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;margin:12px 0;">
  <tr><td style="color:#6b7280;width:35%;"><%= t('Περιγραφή') %></td><td><%= t(charge.description) %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Τεκμηρίωση') %></td><td><%= String(charge.evidence || '').replace(/^Πέραν της απαλλαγής: (.*)$/m, function (m, note) { return t('Πέραν της απαλλαγής: {note}', { note: note }); }) %></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Ποσό') %></td><td><strong><%= format.money(charge.amount_cents) %></strong></td></tr>
  <tr><td style="color:#6b7280;"><%= t('Απάντηση έως') %></td><td><%= format.date(charge.respond_by) %></td></tr>
</table>
<% if (charge.category === 'damage' && booking.excess_cents !== null && booking.excess_cents !== undefined) { %><p><%= t('Η ευθύνη σας για ζημιές περιορίζεται στην απαλλαγή της κράτησής σας ({amount}), εκτός από τις εξαιρέσεις των όρων ενοικίασης (§7).', { amount: format.money(booking.excess_cents) }) %></p><% } %>
<p><strong><%= t('Καμία τέτοια χρέωση δεν γίνεται χωρίς τη συναίνεσή σας.') %></strong> <%= t('Μπορείτε να την αποδεχθείτε ή να την αμφισβητήσετε (με τα σχόλιά σας) από τη σελίδα της κράτησης:') %>
<%- th('<a href="{url}">{url}</a> (κωδικός <strong>{ref}</strong> και το email σας).', { url: `${baseUrl}/manage`, ref: booking.reference }) %></p>
<p><%= t('Μπορείτε επίσης να ζητήσετε τα στοιχεία τεκμηρίωσης (φωτογραφίες, εκτίμηση/τιμολόγιο επισκευής) ή να επικοινωνήσετε μαζί μας.') %></p>
<p><%= company.name %></p>
<%- include('_bottom') %>
