# Ρυθμίσεις για ΔΟΚΙΜΕΣ στον υπολογιστή σας (δημιουργείται αυτόματα ως .env από το start-windows.bat / start-mac.command).
# Για την πραγματική ιστοσελίδα χρησιμοποιήστε το .env.example.
# Μετά από κάθε αλλαγή εδώ: κλείστε την ιστοσελίδα (Ctrl+C) και ξεκινήστε τη ξανά.
# Πιο εύκολα, χωρίς να ανοίξετε αυτό το αρχείο: Διαχείριση → Ρυθμίσεις δοκιμών (http://localhost:3000/admin/settings)
# για email και δοκιμαστικές πληρωμές με κάρτα· γράφει σε αυτό το αρχείο και ξεκινά ξανά την ιστοσελίδα με το κουμπί «Επανεκκίνηση».

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Πού έρχονται οι ειδοποιήσεις του γραφείου (νέες κρατήσεις κ.λπ.)
ADMIN_NOTIFY_EMAIL=

# ---------- Δοκιμαστικές πληρωμές με κάρτα (Stripe, Test mode) ----------
# 1. Λογαριασμός στο https://dashboard.stripe.com (δωρεάν).
# 2. Ενεργοποιήστε το «Test mode» (πάνω δεξιά) → Developers → API keys.
# 3. Αντιγράψτε το «Secret key» (ξεκινά με sk_test_) και επικολλήστε το εδώ:
STRIPE_SECRET_KEY=
# Προαιρετικό στον υπολογιστή (βλ. docs/anoigma-kai-dokimes.md, ενότητα 0):
STRIPE_WEBHOOK_SECRET=

# ---------- Αποστολή email (προαιρετικό) ----------
# Χωρίς αυτά, τα emails δεν στέλνονται αλλά φαίνονται στη Διαχείριση → Έλεγχος συστήματος.
# Παράδειγμα με Gmail: χρειάζεται «Κωδικός εφαρμογής» (App Password) από το https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------- Στοιχεία επιχείρησης (εμφανίζονται στο κάτω μέρος της σελίδας) ----------
COMPANY_NAME=Rent a Car
COMPANY_LEGAL_NAME=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
